# YouTube: path to the OAuth client file downloaded from Google Cloud Console
YT_CLIENT_SECRET=secrets/client_secret.json

# Instagram (Creator account, "Instagram API with Instagram Login")
# Long-lived token, valid ~60 days. Run `python -m insights ig-refresh` before it expires.
IG_ACCESS_TOKEN=
IG_API_VERSION=v25.0

# Report thresholds
MIN_POSTS_FOR_VERDICT=8
MIN_AGE_HOURS=72
